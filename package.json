{
    "name": "or3-scroll",
    "version": "0.1.1",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Saluana/or3-vsc.git"
    },
    "description": "A headless, chat-optimized virtual scroller for Vue 3. Designed for bottom-anchored layouts, streaming content, and dynamic item heights.",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "packageManager": "bun@1.3.14",
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "main": "./dist/or3-scroll.umd.cjs",
    "module": "./dist/or3-scroll.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/or3-scroll.js",
            "require": "./dist/or3-scroll.umd.cjs",
            "types": "./dist/index.d.ts"
        },
        "./style.css": "./dist/style.css"
    },
    "scripts": {
        "dev": "vite examples/ai-streaming-chat --config vite.config.ts",
        "dev:scroll": "vite examples/basic-chat --config vite.config.ts",
        "build": "vue-tsc && vite build",
        "build:demo": "vite build --config vite.demo.config.ts",
        "test": "vitest run",
        "lint": "eslint src",
        "prepublishOnly": "bun run build && bun run test"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "vue": "^3.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@microsoft/api-extractor": "^7.58.12",
        "@types/node": "^24.10.1",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/test-utils": "^2.4.11",
        "ajv": "^8.17.1",
        "eslint": "^10.7.0",
        "eslint-plugin-vue": "^10.10.0",
        "globals": "^17.7.0",
        "jsdom": "^29.1.1",
        "katex": "^0.16.47",
        "streamdown-vue": "^1.0.29",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.1.5",
        "vite-plugin-dts": "^5.0.3",
        "vitest": "^4.1.10",
        "vue": "^3.5.40",
        "vue-tsc": "^3.3.7"
    }
}
